# Copy to .env.local for local development: `cp .env.example .env.local`
# Every variable is validated by src/lib/env.schema.ts; `next dev` and `next build` fail on invalid values.
# On Vercel, set these in Project Settings > Environment Variables (Marketplace integrations add theirs automatically).

# ---------------------------------------------------------------- site
# Canonical origin used for canonical URLs, sitemap, Open Graph and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- database (MongoDB)
# Local default: `pnpm dev` starts MongoDB on this address itself (data kept in .data/mongo). No Docker needed.
# Production: MongoDB Atlas connection string (Vercel Marketplace > MongoDB Atlas sets this for you).
MONGODB_URI=mongodb://127.0.0.1:27018/
MONGODB_DB=ppf

# ---------------------------------------------------------------- email (lead notifications)
# "console" logs that an email would be sent (development). "resend" sends for real (required in production).
EMAIL_PROVIDER=console
# Resend API key (starts with re_). Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Verified sender, e.g. "PPF Phantom <leads@yourdomain.ae>". Required when EMAIL_PROVIDER=resend.
EMAIL_FROM=
# Comma-separated staff addresses that receive new lead notifications.
LEAD_NOTIFICATION_TO=leads@example.com

# ---------------------------------------------------------------- rate limiting
# "memory" works for a single local process. "upstash" is required in production.
RATE_LIMIT_STORE=memory
# Upstash Redis REST credentials (Vercel Marketplace > Upstash sets these). Required when RATE_LIMIT_STORE=upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- bot protection (Cloudflare Turnstile)
# The values below are Cloudflare's always-pass TEST keys for local development.
# Production must use real keys from the Cloudflare dashboard (validation rejects test keys there).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
